# Copy to .env.local and fill in real values. Never commit .env.local.
# No secrets in code — every key here is read from process.env only (CLAUDE.md Coding Standards).

# Supabase — specs/01-database-schema.md
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Clinical risk investigator + mock agent simulator — specs/04-investigator.md, specs/00-mock-agent-simulator.md
OPENAI_API_KEY=

# Injection pre-screen (Layer 1) — docs/engineering/architecture.md
AZURE_CONTENT_SAFETY_ENDPOINT=
AZURE_CONTENT_SAFETY_KEY=

# Observability (P1) — specs/07-observability.md. Optional: lib/observability/tracer.ts
# degrades gracefully (spans created but not exported) if unset. This is the
# connection string of the Application Insights resource linked to the
# Foundry project (Project > Tracing > Manage data source > Connection
# string in the Foundry portal) — not a URL + API key pair.
AZURE_FOUNDRY_CONNECTION_STRING=

# eval/run.ts's target Gateway API — defaults to http://localhost:3000 if unset.
GATEWAY_BASE_URL=

# Reviewer-surface Basic Auth gate (middleware.ts) — required for /review-queue
# and /dashboard to load at all; unset means those routes 500 (fail-closed,
# not open). Not a full auth system — one shared credential, deliberately.
REVIEWER_BASIC_AUTH_USER=
REVIEWER_BASIC_AUTH_PASSWORD=
